# Copy this file to .env and fill in your own keys.
# PhishGuard runs in offline/heuristic-only mode if these are left blank.

# https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional live URL reputation sources.
PHISHTANK_API_KEY=
URLHAUS_ENABLED=false

# Set true to enable WHOIS, blocklist, redirect, and hash lookups.
PHISHGUARD_ENABLE_NETWORK_LOOKUPS=false
